import UIKit
import CoreLocation

class ViewController: UIViewController, CLLocationManagerDelegate, UITextFieldDelegate {

    // MARK: - IBOutlets
    @IBOutlet weak var cityTextField: UITextField!
    @IBOutlet weak var searchButton: UIButton!
    @IBOutlet weak var locationButton: UIButton!
    @IBOutlet weak var tempLabel: UILabel!
    @IBOutlet weak var humidityLabel: UILabel!
    @IBOutlet weak var descriptionLabel: UILabel!
    @IBOutlet weak var cityNameLabel: UILabel!
    @IBOutlet weak var activityIndicator: UIActivityIndicatorView!
    
    // MARK: - Properties
    let locationManager = CLLocationManager()
    let apiKey = "YOUR_API_KEY"  // Замените на ваш ключ OpenWeatherMap
    
    // MARK: - Lifecycle
    override func viewDidLoad() {
        super.viewDidLoad()
        setupUI()
        setupTextField()
        setupLocationManager()
    }
    
    // MARK: - UI Setup
    func setupUI() {
        searchButton.layer.cornerRadius = 8
        locationButton.layer.cornerRadius = 8
        
        tempLabel.layer.cornerRadius = 8
        tempLabel.layer.borderWidth = 1
        tempLabel.layer.borderColor = UIColor.lightGray.cgColor
        
        humidityLabel.layer.cornerRadius = 8
        humidityLabel.layer.borderWidth = 1
        humidityLabel.layer.borderColor = UIColor.lightGray.cgColor
        
        descriptionLabel.layer.cornerRadius = 8
        descriptionLabel.layer.borderWidth = 1
        descriptionLabel.layer.borderColor = UIColor.lightGray.cgColor
        
        activityIndicator.hidesWhenStopped = true
    }
    
    func setupTextField() {
        cityTextField.delegate = self
        cityTextField.layer.cornerRadius = 8
        cityTextField.layer.borderWidth = 1
        cityTextField.layer.borderColor = UIColor.lightGray.cgColor
        cityTextField.leftView = UIView(frame: CGRect(x: 0, y: 0, width: 10, height: 0))
        cityTextField.leftViewMode = .always
    }
    
    // MARK: - CoreLocation Setup
    func setupLocationManager() {
        locationManager.delegate = self
        locationManager.desiredAccuracy = kCLLocationAccuracyBest
        locationManager.requestWhenInUseAuthorization()
    }
    
    // MARK: - Weather API
    
    func fetchWeather(city: String) {
        activityIndicator.startAnimating()
        
        let urlString = "https://api.openweathermap.org/data/2.5/weather?q=\(city)&appid=\(apiKey)&units=metric&lang=ru"
        
        guard let encodedString = urlString.addingPercentEncoding(withAllowedCharacters: .urlQueryAllowed),
              let url = URL(string: encodedString) else {
            showError(message: "Неверный формат города")
            activityIndicator.stopAnimating()
            return
        }
        
        URLSession.shared.dataTask(with: url) { [weak self] data, response, error in
            DispatchQueue.main.async {
                self?.activityIndicator.stopAnimating()
            }
            
            if let error = error {
                DispatchQueue.main.async {
                    self?.showError(message: "Ошибка сети: \(error.localizedDescription)")
                }
                return
            }
            
            guard let data = data else {
                DispatchQueue.main.async {
                    self?.showError(message: "Нет данных от сервера")
                }
                return
            }
            
            self?.parseWeatherData(data: data)
            
        }.resume()
    }
    
    func parseWeatherData(data: Data) {
        do {
            let json = try JSONSerialization.jsonObject(with: data) as? [String: Any]
            
            if let cod = json?["cod"] as? Int, cod != 200 {
                DispatchQueue.main.async {
                    self.showError(message: "Город не найден")
                }
                return
            }
            
            let main = json?["main"] as? [String: Any]
            let temp = main?["temp"] as? Double
            let humidity = main?["humidity"] as? Int
            
            let weatherArray = json?["weather"] as? [[String: Any]]
            let weather = weatherArray?.first
            let description = weather?["description"] as? String
            
            let name = json?["name"] as? String
            
            DispatchQueue.main.async { [weak self] in
                guard let self = self else { return }
                
                if let temp = temp {
                    self.tempLabel.text = "🌡️ \(Int(temp))°C"
                }
                
                if let humidity = humidity {
                    self.humidityLabel.text = "💧 Влажность: \(humidity)%"
                }
                
                if let description = description {
                    self.descriptionLabel.text = "☁️ \(description.capitalized)"
                }
                
                if let name = name {
                    self.cityNameLabel.text = "📍 \(name)"
                }
            }
            
        } catch {
            DispatchQueue.main.async {
                self.showError(message: "Ошибка обработки данных")
            }
        }
    }
    
    // MARK: - Геолокация
    
    func fetchWeatherByLocation(latitude: Double, longitude: Double) {
        activityIndicator.startAnimating()
        
        let urlString = "https://api.openweathermap.org/data/2.5/weather?lat=\(latitude)&lon=\(longitude)&appid=\(apiKey)&units=metric&lang=ru"
        
        guard let url = URL(string: urlString) else {
            activityIndicator.stopAnimating()
            return
        }
        
        URLSession.shared.dataTask(with: url) { [weak self] data, response, error in
            DispatchQueue.main.async {
                self?.activityIndicator.stopAnimating()
            }
            
            guard let data = data, error == nil else {
                DispatchQueue.main.async {
                    self?.showError(message: "Не удалось получить погоду по геолокации")
                }
                return
            }
            
            self?.parseWeatherData(data: data)
            
        }.resume()
    }
    
    // MARK: - CLLocationManagerDelegate
    
    func locationManager(_ manager: CLLocationManager, didUpdateLocations locations: [CLLocation]) {
        guard let location = locations.last else { return }
        
        locationManager.stopUpdatingLocation()
        
        let latitude = location.coordinate.latitude
        let longitude = location.coordinate.longitude
        
        fetchWeatherByLocation(latitude: latitude, longitude: longitude)
        
        CLGeocoder().reverseGeocodeLocation(location) { [weak self] placemarks, error in
            if let city = placemarks?.first?.locality {
                DispatchQueue.main.async {
                    self?.cityTextField.text = city
                }
            }
        }
    }
    
    func locationManager(_ manager: CLLocationManager, didFailWithError error: Error) {
        showError(message: "Ошибка геолокации: \(error.localizedDescription)")
    }
    
    func locationManagerDidChangeAuthorization(_ manager: CLLocationManager) {
        switch manager.authorizationStatus {
        case .authorizedWhenInUse, .authorizedAlways:
            break
        case .denied, .restricted:
            showError(message: "Доступ к геолокации запрещен. Включите в настройках.")
        case .notDetermined:
            locationManager.requestWhenInUseAuthorization()
        @unknown default:
            break
        }
    }
    
    // MARK: - UITextFieldDelegate
    
    func textFieldShouldReturn(_ textField: UITextField) -> Bool {
        textField.resignFirstResponder()
        
        if let city = textField.text, !city.isEmpty {
            fetchWeather(city: city)
        }
        
        return true
    }
    
    // MARK: - IBActions
    
    @IBAction func searchButtonTapped(_ sender: UIButton) {
        cityTextField.resignFirstResponder()
        
        guard let city = cityTextField.text, !city.isEmpty else {
            showError(message: "Введите название города")
            return
        }
        
        fetchWeather(city: city)
    }
    
    @IBAction func locationButtonTapped(_ sender: UIButton) {
        let status = locationManager.authorizationStatus
        
        switch status {
        case .authorizedWhenInUse, .authorizedAlways:
            locationManager.startUpdatingLocation()
        case .denied, .restricted:
            showError(message: "Разрешите доступ к геолокации в настройках")
        case .notDetermined:
            locationManager.requestWhenInUseAuthorization()
        @unknown default:
            break
        }
    }
    
    // MARK: - Helper Methods
    
    func showError(message: String) {
        let alert = UIAlertController(title: "Ошибка", 
                                      message: message, 
                                      preferredStyle: .alert)
        alert.addAction(UIAlertAction(title: "OK", style: .default))
        present(alert, animated: true)
    }
}
